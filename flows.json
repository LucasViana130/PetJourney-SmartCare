[
  {
    "id": "tab1",
    "type": "tab",
    "label": "PetJourney VitalCare"
  },
  {
    "id": "mqtt_temp",
    "type": "mqtt in",
    "z": "tab1",
    "name": "Temperatura",
    "topic": "petjourney/temperatura",
    "broker": "broker1",
    "x": 120,
    "y": 80,
    "wires": [["fn_temp"]]
  },
  {
    "id": "fn_temp",
    "type": "function",
    "z": "tab1",
    "name": "Regra Temperatura",
    "func": "msg.payload = parseFloat(msg.payload);\nif(msg.payload > 39){\nreturn [msg,{payload:'⚠️ Possivel febre no pet'}];\n}\nreturn [msg,null];",
    "outputs": 2,
    "x": 350,
    "y": 80,
    "wires": [["gauge_temp","chart_temp"],["toast_alert"]]
  },
  {
    "id": "mqtt_bpm",
    "type": "mqtt in",
    "z": "tab1",
    "name": "BPM",
    "topic": "petjourney/bpm",
    "broker": "broker1",
    "x": 120,
    "y": 240,
    "wires": [["fn_bpm"]]
  },
  {
    "id": "fn_bpm",
    "type": "function",
    "z": "tab1",
    "name": "Regra BPM",
    "func": "msg.payload = parseInt(msg.payload);\nif(msg.payload > 140){\nreturn [msg,{payload:'⚠️ BPM elevado'}];\n}\nif(msg.payload < 60){\nreturn [msg,{payload:'⚠️ BPM abaixo do normal'}];\n}\nreturn [msg,null];",
    "outputs": 2,
    "x": 340,
    "y": 240,
    "wires": [["gauge_bpm","chart_bpm"],["toast_alert"]]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "tab1",
    "name": "Gauge Temp",
    "group": "group1",
    "order": 1,
    "width": "4",
    "height": "4",
    "gtype": "gauge",
    "title": "Temperatura Corporal",
    "label": "°C",
    "format": "{{value}}",
    "min": "30",
    "max": "45",
    "x": 630,
    "y": 80,
    "wires": []
  },
  {
    "id": "gauge_bpm",
    "type": "ui_gauge",
