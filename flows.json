    "height": "4",
    "gtype": "gauge",
    "title": "Batimentos Cardiacos",
    "label": "BPM",
    "format": "{{value}}",
    "min": "40",
    "max": "180",
    "x": 620,
    "y": 240,
    "wires": []
  },
  {
